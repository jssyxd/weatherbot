{
  "mode": "paper",
  "execution_engine": "tree6yes",
  "execution_order_type": "FAK",
  "target_order_shares": "5",
  "min_execution_price": "0.92",
  "max_execution_price": "0.98",
  "max_slippage": "0.01",
  "local_book_max_age_seconds": 3,
  "market_ws_enabled": true,

  "checkwx_api_key_env": "CHECKWX_API_KEY",
  "scan_interval_seconds": 120,
  "rate_limit_backoff_seconds": 120,
  "stations_per_request": 25,
  "awc_warmup_hours": 48,
  "awc_fallback_hours": 2,
  "max_report_age_seconds": 900,
  "failure_pause_after_seconds": 1800,

  "warmup_retry_seconds": 120,
  "warmup_max_stations_per_cycle": 8,
  "market_rules_max_age_seconds": 900,

  "tail_consensus_enabled": true,
  "tail_consensus_high_start_local": "12:00",
  "tail_consensus_high_end_local": "17:00",
  "tail_consensus_low_start_local": "01:00",
  "tail_consensus_low_end_local": "05:00",
  "tail_consensus_stability_seconds": 1800,
  "tail_consensus_stable_min_price": "0.90",
  "tail_consensus_entry_min_price": "0.92",
  "tail_consensus_entry_max_price": "0.98",
  "tail_consensus_price_mode": "best_ask_plus_one_tick",
  "tail_consensus_target_shares": "5",
  "tail_consensus_max_open_positions": 10,
  "tail_consensus_market_alert_bid": "0.85",
  "tail_consensus_rotation_multiplier": "3",
  "tail_consensus_max_rotations": 1,

  "contract_cities_path": "config/contract_cities.json",
  "market_rules_path": "data/market_rules.json",
  "state_path": "data/state.json",
  "event_dir": "data/observations",
  "signal_dir": "data/signals",
  "health_path": "data/health.json",
  "audit_db_path": "data/audit.sqlite3"
}
