# =============================================================================
# weatherbot tree12-allnopart 环境变量模板
# 复制为 .env 后填写真实值。绝对不要把真实私钥提交到 Git。
# =============================================================================

# CheckWX Aviation Weather API（必填，用于 METAR/TAF）
CHECKWX_API_KEY=replace-with-your-checkwx-api-key

# ---------- 仅当 mode=live 时需要 ----------
# Polymarket CLOB 交易私钥（Polygon 钱包私钥，0x 开头）
# 警告：拥有此私钥即拥有钱包全部资金。仅在受控机器、加密磁盘上使用。
# POLYMARKET_PRIVATE_KEY=0x_your_private_key_here

# 可选：Polymarket API 凭证（若使用官方 API key 流）
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# 可选：代理（若部署环境需要）
# HTTP_PROXY=
# HTTPS_PROXY=
